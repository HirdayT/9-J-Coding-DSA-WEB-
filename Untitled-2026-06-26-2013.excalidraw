      "baseFontSize": null
    },
    {
      "id": "ugOnhNo5GKogLUKltqdUn",
      "type": "text",
      "x": 41077.67275965829,
      "y": 3584.5843266185834,
      "width": 615.8155517578125,
      "height": 207,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brp",
      "roundness": null,
      "seed": 1084624094,
      "version": 219,
      "versionNonce": 2146008030,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "HCtaBzwiGa9v2oIWoNKhw",
          "type": "arrow"
        }
      ],
      "updated": 1783958356653,
      "link": null,
      "locked": false,
      "text": "SELECT ENAME ,SAL \nFROM EMP \nWHERE SAL > ( SELECT SAL \n                                    FROM EMP \n                                      WHERE DEPTNO = 10 ) ;",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT ENAME ,SAL \nFROM EMP \nWHERE SAL > ( SELECT SAL \n                                    FROM EMP \n                                      WHERE DEPTNO = 10 ) ;",
      "autoResize": true,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "-3cWed3H_6fZ0L4YYctCs",
      "type": "text",
      "x": 42061.107917666566,
      "y": 3833.6982164734254,
      "width": 511.34375,
      "height": 579.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
