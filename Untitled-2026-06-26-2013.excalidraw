      "text": "1. WAQTD  ename and salary of the employees earning more than employees of dept 10 .",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. WAQTD  ename and salary of the employees earning more than employees of dept 10 .",
      "autoResize": true,
      "lineHeight": 1.15,
