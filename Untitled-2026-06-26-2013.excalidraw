    },
    {
      "id": "-szIFFhi0MHX9ebkW8BpZ",
      "type": "text",
      "x": 10167.186045786579,
      "y": 1039.6524195129302,
      "width": 1286.999267578125,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
