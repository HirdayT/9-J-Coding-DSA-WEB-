      "updated": 1784042924545,
      "link": null,
      "locked": false,
      "text": "Here we cannot use > operator to compare \nMultiple values .\n\nwe can't use IN or , NOT IN as well because \nIt is used for = and != operators .\n\nTherefore, we have to use Sub Query \nOperators instead of \nRelational Operators such as (>, < ,<=,>=) ",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here we cannot use > operator to compare \nMultiple values .\n\nwe can't use IN or , NOT IN as well because \nIt is used for = and != operators .\n\nTherefore, we have to use Sub Query \nOperators instead of \nRelational Operators such as (>, < ,<=,>=) ",
      "autoResize": true,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
