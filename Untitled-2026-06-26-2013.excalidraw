      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": ">SELECT JOB,MAX(SAL)\nFROM EMP \nGROUP BY JOB \nHAVING MAX(SAL) > 2000 ;",
      "autoResize": true,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "t1xO8lf9hpM1n62GM9upb",
      "type": "text",
      "x": 34254.599167543354,
      "y": 5737.595880255837,
      "width": 1840.3907470703125,
      "height": 786.6,
      "angle": 0,
      "strokeColor": "#121212",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bkE",
      "roundness": null,
      "seed": 1287463213,
      "version": 81,
      "versionNonce": 1305468024,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783607631099,
      "link": null,
      "locked": false,
      "text": "ASSIGNMENT QUESTIONS ON HAVING CLAUSE\n\n\n1.WAQTD DNO AND NUMBER OF EMP WORKING IN EACH DEPT IF THERE\nARE ATLEAST 2 CLERKS IN EACH DEPT\n2.WAQTD DNO AND TOTAL SAALARYNEEDED TO PAY ALL EMP\nIN EACH DEPT IF THERE ARE ATLEAST 4 EMP IN EACH DEPT\n3.WAQTD NUMBER OF EMP EARNING SAL MORE THAN 1200 IN EACH JOB\nAND THE TOTAL SAL NEEDED TO PAY EMP OF EACH JOB MUST EXCEES 3800\n4.WAQTD DEPTNO AND NUMBER OF EMP WORKING ONLY IF THERE ARE 2 EMP WORKING IN EACH DEPT AS MANAGER .\n5.WAQTD JOB AND MAX SAL OF EMP IN EACH JOB IF THE MAX SAL EXCEEDS 2600\n6.WAQTD THE SALARIES WHICH ARE REPEATED IN EMP TABLE\n7.WAQTD THE HIREDATE WHICH ARE DUPLICATED IN EMP TABLE\n8.WAQTD AVG SALARY OF EACH DEPT IF AVG SAL IS LESS THAN 3000\n9.WAQTD DEPTNO IF THERE ARE ATLEAST 3 EMP IN EACH DEPT WHOS NAME\nHAS CHAR 'A' OR 'S' .\n10.WAQTD MIN AND MAX SALARIES OF EACH JOB IF MIN SAL IS MORE THAN 1000 AND MAX SAL IS LESS THAN \n5000 .\n",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ASSIGNMENT QUESTIONS ON HAVING CLAUSE\n\n\n1.WAQTD DNO AND NUMBER OF EMP WORKING IN EACH DEPT IF THERE\nARE ATLEAST 2 CLERKS IN EACH DEPT\n2.WAQTD DNO AND TOTAL SAALARYNEEDED TO PAY ALL EMP\nIN EACH DEPT IF THERE ARE ATLEAST 4 EMP IN EACH DEPT\n3.WAQTD NUMBER OF EMP EARNING SAL MORE THAN 1200 IN EACH JOB\nAND THE TOTAL SAL NEEDED TO PAY EMP OF EACH JOB MUST EXCEES 3800\n4.WAQTD DEPTNO AND NUMBER OF EMP WORKING ONLY IF THERE ARE 2 EMP WORKING IN EACH DEPT AS MANAGER .\n5.WAQTD JOB AND MAX SAL OF EMP IN EACH JOB IF THE MAX SAL EXCEEDS 2600\n6.WAQTD THE SALARIES WHICH ARE REPEATED IN EMP TABLE\n7.WAQTD THE HIREDATE WHICH ARE DUPLICATED IN EMP TABLE\n8.WAQTD AVG SALARY OF EACH DEPT IF AVG SAL IS LESS THAN 3000\n9.WAQTD DEPTNO IF THERE ARE ATLEAST 3 EMP IN EACH DEPT WHOS NAME\nHAS CHAR 'A' OR 'S' .\n10.WAQTD MIN AND MAX SALARIES OF EACH JOB IF MIN SAL IS MORE THAN 1000 AND MAX SAL IS LESS THAN \n5000 .\n",
      "autoResize": true,
      "lineHeight": 1.15,
      "created": null,
