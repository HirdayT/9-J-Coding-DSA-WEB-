      "updated": 1781797888647,
      "link": null,
      "locked": false,
      "text": "1)CHAR:- In character datatype we can store 'A-Z','a-z','0-9'\n            and special character($,@,&,!.....).\n\n           -> Characters must always be enclosed within single quotes ' '.\n           ->Whenever we use char datatype we must mention size .\n           ->Size-> It is used to specify number of character it can store \n                      ->The maximum number of character that we can store is\n                           ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1)CHAR:- In character datatype we can store 'A-Z','a-z','0-9'\n            and special character($,@,&,!.....).\n\n           -> Characters must always be enclosed within single quotes ' '.\n           ->Whenever we use char datatype we must mention size .\n           ->Size-> It is used to specify number of character it can store \n                      ->The maximum number of character that we can store is\n                           ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
