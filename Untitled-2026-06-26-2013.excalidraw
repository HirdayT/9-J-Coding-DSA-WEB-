      "versionNonce": 241479234,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783353085956,
      "link": null,
      "locked": false,
      "text": "1)MAX(): it is used to obtain the maximum value present in the column \n2)MIN(): it is used to obtain the minimum value of the column\n3)SUM():it is used to obtain the summation of values present in the columns \n4)AVG():it is used to obtain the average of values present in the columns\n5)COUNT():it is used to obtain the number of values present in the columns.\n",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1)MAX(): it is used to obtain the maximum value present in the column \n2)MIN(): it is used to obtain the minimum value of the column\n3)SUM():it is used to obtain the summation of values present in the columns \n4)AVG():it is used to obtain the average of values present in the columns\n5)COUNT():it is used to obtain the number of values present in the columns.\n",
      "autoResize": true,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
