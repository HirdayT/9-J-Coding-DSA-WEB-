      "locked": false,
      "text": "SELECT DEPTNO , COUNT(*)\nFROM EMP\nWHERE JOB NOT IN 'ANALYST'\nGROUP BY DEPTNO ;\n",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT DEPTNO , COUNT(*)\nFROM EMP\nWHERE JOB NOT IN 'ANALYST'\nGROUP BY DEPTNO ;\n",
