    {
      "id": "WBr4xx2k_DekpPjB1uZq4",
      "type": "text",
      "x": 40929.0529053703,
      "y": 474.5905382456433,
      "width": 1583.9460394754126,
      "height": 662.4,
      "angle": 0,
      "strokeColor": "#1e1e1e",
