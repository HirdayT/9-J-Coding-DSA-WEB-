    {
      "id": "pEp2PDCjpj6iy3APYMA2E",
      "type": "text",
      "x": 14590.876526648906,
      "y": 2312.283007481825,
      "width": 2006.74755859375,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
