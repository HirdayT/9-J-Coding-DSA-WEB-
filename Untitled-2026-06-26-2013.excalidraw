      "isDeleted": false,
      "boundElements": [],
      "updated": 1784389136139,
      "link": null,
      "locked": false,
      "text": "\"The process of retrieval of data from multiple tables simultaneously \n is known as JOINS \"",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"The process of retrieval of data from multiple tables simultaneously \n is known as JOINS \"",
      "autoResize": true,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "uxumKl85J3sljQXuSp6Nx",
