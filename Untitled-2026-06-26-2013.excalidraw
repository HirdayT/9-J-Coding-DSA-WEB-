      "text": "It is an alternate name given to a column or an \nExpression in the result table .\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is an alternate name given to a column or an \nExpression in the result table .\n",
