    },
    {
      "id": "eSraGU9QV-ANKQ9fNRWq6",
      "type": "text",
      "x": 21657.976747466604,
      "y": -412.9008151867698,
      "width": 1036.5115966796875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
