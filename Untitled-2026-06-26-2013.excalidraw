      "link": null,
      "locked": false,
      "text": "SELECT E1.ENAME,E1.SAL,E2.NAME,E2.SAL\nFROM EMP E1,EMP E2\nWHERE E1.MGR = E2.EMPNO ;",
      "fontSize": 36,
