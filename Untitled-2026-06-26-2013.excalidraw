      "versionNonce": 35024519,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782832925528,
      "link": null,
      "locked": false,
      "text": "> We can assign alias name with or without using 'As' keyword.\n> Alias names have to be a single string which is separated by \n    an underscore '_', or enclosed within double quotes .",
