      "text": "Emp\nEID          ENAME    SAL         DEPTNO\n1               ALLEN      1000         20\n2               BLAKE      2000         10\n3               CLARK      3000          30\n4               MILLER    1500         10\n5               SMITH       2500         10\n\n\nDEPT\nDEPTNO   DNAME   LOC\n10               D1             L1\n20               D2             L2\n30               D3             L3",
