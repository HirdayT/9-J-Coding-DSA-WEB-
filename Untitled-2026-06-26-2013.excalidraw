    },
    {
      "id": "rw_P4qVMEeSnsc0q6BRzC",
      "type": "text",
      "x": 75819.84053119233,
      "y": -2041.2446135074397,
      "width": 1114.931640625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0p4",
      "roundness": null,
      "seed": 643675744,
      "version": 222,
      "versionNonce": 2083193440,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785944875383,
      "link": null,
      "locked": false,
      "text": "\"it is the process of reducing a large table into smaller tables in order to remove \nredundancies and anomalies by identifying their functional dependencies is\nknown as Normalisation.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"it is the process of reducing a large table into smaller tables in order to remove \nredundancies and anomalies by identifying their functional dependencies is\nknown as Normalisation.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
