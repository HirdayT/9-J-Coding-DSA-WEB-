      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT group_by_expression/group function\nFROM table_name\n[WHERE <filter_condition>]\nGROUP BY column_name/expression\nHAVING <group_filter_condition>",
