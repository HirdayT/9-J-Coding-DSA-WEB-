    },
    {
      "id": "fIty3A05JoPGRmGulRyuQ",
      "type": "text",
      "x": 41097.09215346939,
      "y": 3218.544880814414,
      "width": 1196.675537109375,
      "height": 82.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bre",
      "roundness": null,
      "seed": 983134658,
      "version": 185,
      "versionNonce": 1143516034,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783957616601,
      "link": null,
      "locked": false,
      "text": "It is difficult to identify whether a query belongs to Single or Multi Row \nSo , It is always recommended to use Special Operators to compare the Values.",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is difficult to identify whether a query belongs to Single or Multi Row \nSo , It is always recommended to use Special Operators to compare the Values.",
