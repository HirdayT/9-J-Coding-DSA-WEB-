      "containerId": null,
      "originalText": ">WAQTD to find the number of employees working in each Dept.\n    if there are at least 2  employees in each dept.\n",
      "autoResize": true,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
