      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT JOB , COUNT(*)\nFROM EMP\nGROUP BY JOB\nHAVING COUNT(*) >=2 ;",
