      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT ENAME , COUNT(*)\nFROM EMP \nGROUP BY ENAME\nHAVING COUNT(*) > 1 ;\n\n\n ",
