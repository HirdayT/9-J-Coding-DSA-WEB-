      "isDeleted": false,
      "boundElements": [],
      "updated": 1785168256963,
      "link": null,
      "locked": false,
      "text": "\"It behaves as INNER JOIN if there is a relation between the given two tables \n,else it behaves as CROSS JOIN \". ",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"It behaves as INNER JOIN if there is a relation between the given two tables \n,else it behaves as CROSS JOIN \". ",
      "autoResize": true,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
