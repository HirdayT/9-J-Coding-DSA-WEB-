      "link": null,
      "locked": false,
      "text": "1)ANSI \n        SELECT COLUMN_NAME\n        FROM TABLE_NAME1 FULL JOIN TABLE_NAME2 \n        ON <JOIN_CONDITION> ;\n\n\n        SELECT *\n         FROM EMP FULL JOIN DEPT\n          ON EMP.DEPTNO = DEPT.DEPTNO ;",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1)ANSI \n        SELECT COLUMN_NAME\n        FROM TABLE_NAME1 FULL JOIN TABLE_NAME2 \n        ON <JOIN_CONDITION> ;\n\n\n        SELECT *\n         FROM EMP FULL JOIN DEPT\n          ON EMP.DEPTNO = DEPT.DEPTNO ;",
