      "isDeleted": false,
      "boundElements": [],
      "updated": 1783957310776,
      "link": null,
      "locked": false,
      "text": "NOTE:-  ",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
