    {
      "id": "FenO5y_VrECx_FKJyGIYH",
      "type": "text",
      "x": 32597.738601252262,
      "y": 5129.018669802566,
      "width": 1615.0305853193065,
      "height": 952.1999999999999,
      "angle": 0,
      "strokeColor": "#121212",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
