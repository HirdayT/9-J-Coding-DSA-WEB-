      "type": "text",
      "x": 30197.91740268308,
      "y": 1812.8594567198822,
      "width": 1168.5234375,
      "height": 248.39999999999998,
      "angle": 0,
      "strokeColor": "#121212",
      "backgroundColor": "transparent",
