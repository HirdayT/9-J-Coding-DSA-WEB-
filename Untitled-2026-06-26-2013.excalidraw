          "id": "FHp0P-e1PVEYlVfKmubMr",
          "type": "arrow"
        }
      ],
      "updated": 1782228830310,
      "link": null,
      "locked": false,
      "text": "Charecteristics of primary key \n\n1)- We can have only One primary key in a table .\n2)- PK cannot accept duplicates/ repeated values .\n3)- PK cannot accept NULL values . \n4)- PK is always a combination of UNIQUE and NOT NULL CONSTRAINT.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Charecteristics of primary key \n\n1)- We can have only One primary key in a table .\n2)- PK cannot accept duplicates/ repeated values .\n3)- PK cannot accept NULL values . \n4)- PK is always a combination of UNIQUE and NOT NULL CONSTRAINT.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
