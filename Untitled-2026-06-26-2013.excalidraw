      "boundElements": [],
      "updated": 1783439000726,
      "link": null,
      "locked": false,
      "text": "NOTE:- >GROUP BY clause is used to group the records\n                   >GROUP BY clause executes row by row \n                   >After the execution of GROUP By clause we get GROUPS \n                    >Therefore any clause that executes after group by must execute Group by Group \n                   >The Column_name or expression used for grouping can be used in select clause.\n                    >Group By clause can also be used without where clause .\n ",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE:- >GROUP BY clause is used to group the records\n                   >GROUP BY clause executes row by row \n                   >After the execution of GROUP By clause we get GROUPS \n                    >Therefore any clause that executes after group by must execute Group by Group \n                   >The Column_name or expression used for grouping can be used in select clause.\n                    >Group By clause can also be used without where clause .\n ",
      "autoResize": true,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
